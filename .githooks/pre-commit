#!/bin/sh
# Enable once per clone with: git config core.hooksPath .githooks
set -e

echo "pre-commit: cargo fmt --check"
cargo fmt --all --check

echo "pre-commit: cargo lint (clippy -D warnings)"
cargo --quiet lint

echo "pre-commit: cargo doc"
RUSTDOCFLAGS="-D warnings" cargo doc --workspace --no-deps --document-private-items --quiet
